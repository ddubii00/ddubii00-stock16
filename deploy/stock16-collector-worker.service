[Unit]
Description=stock16 queued official data collector worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stock16
Group=stock16
WorkingDirectory=/var/www/stock16-7
EnvironmentFile=/var/www/stock16-7/.env
ExecStart=/var/www/stock16-7/.venv/bin/python -m stock16 collector-worker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/stock16-7/data
MemoryMax=768M
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
