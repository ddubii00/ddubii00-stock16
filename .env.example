# Copy to .env using: python -m stock16 setup
# Never commit populated environment files. No password is shipped.
STOCK16_PASSWORD_HASH=
STOCK16_SECRET_KEY=
STOCK16_DATA_DIR=/var/www/stock16-7/data
STOCK16_BASE_PATH=/stock16-7
STOCK16_SECURE_COOKIE=1
STOCK16_PORT=3016
STOCK16_SEC_USER_AGENT=
OPENDART_API_KEY=
STOCK16_BACKUP_DAILY=3
STOCK16_BACKUP_WEEKLY=2
STOCK16_BACKUP_MONTHLY=3
STOCK16_ETF_BACKFILL_DAYS=30
STOCK16_ETF_REVISION_DAYS=7
STOCK16_RAW_MONTHS=12
# Optional HTTPS webhook. Receives only storage metrics. Set outside Git.
STOCK16_ALERT_WEBHOOK=
